<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.5">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="AdventureWorksLT Load Test" enabled="true">
      <stringProp name="TestPlan.comments"></stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Thread Group" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
        <intProp name="ThreadGroup.num_threads">10</intProp>
        <intProp name="ThreadGroup.ramp_time">10</intProp>
        <longProp name="ThreadGroup.duration">60</longProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Managed Identity JDBC Query" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import groovy.json.JsonSlurper
import java.sql.DriverManager
import com.microsoft.sqlserver.jdbc.SQLServerDriver

// 1) Get token from IMDS
def imdsUrl = 'http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&amp;resource=https%3A%2F%2Fdatabase.windows.net%2F'
def u = new URL(imdsUrl)
def conn = u.openConnection()
conn.setRequestProperty('Metadata','true')
conn.connect()
def resp = new JsonSlurper().parse(conn.inputStream)
def token = resp.access_token

// 2) Load driver and open connection
// Ensure mssql-jdbc jar is added to JMeter classpath/dependencies when uploading
Class.forName('com.microsoft.sqlserver.jdbc.SQLServerDriver')

// Build connection URL
def url = 'jdbc:sqlserver://demodbwatcher01.database.windows.net:1433;database=AdventureWorksLT;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30;'

// Get connection without credentials then set access token
def props = new Properties()
props.setProperty('encrypt','true')
props.setProperty('hostNameInCertificate','*.database.windows.net')
// Open connection
def connObj = DriverManager.getConnection(url, props)

// Set access token on SQLServerConnection if available
try {
  def sqlConnClass = com.microsoft.sqlserver.jdbc.SQLServerConnection
  if (sqlConnClass.isInstance(connObj)) {
    sqlConnClass.cast(connObj).setAccessToken(token)
  } else {
    // try reflection fallback
    def method = connObj.class.getMethod('setAccessToken', String.class)
    method.invoke(connObj, token)
  }
} catch(all) {
  log.info('Could not set access token via SQLServerConnection.setAccessToken: ' + all.toString())
}

// Execute a simple query
def stmt = connObj.createStatement()
def rs = stmt.executeQuery('SELECT TOP 10 * FROM SalesLT.Customer')
int count = 0
while (rs.next()) {
  count++
}
vars.put('rowCount', count.toString())
stmt.close()
connObj.close()

log.info('Managed Identity query returned rows: ' + count)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
