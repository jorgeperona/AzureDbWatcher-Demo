# Copy to .env and replace placeholders. Load only a trusted file: source executes shell code.
AZURE_LOCATION=swedencentral
CONTROL_RESOURCE_GROUP=rg-datasaturday-jobs
RESOURCE_TAGS_JSON='{"project":"rg-datasaturday-jobs"}'
CONTROL_SERVER_NAME=REPLACE-unique-control-server
JOB_DATABASE_NAME=datasaturdayjobs
JOB_AGENT_NAME=ej-datasaturday
JOB_AGENT_SKU=JA100
JOB_DATABASE_SKU=S1
MANAGED_IDENTITY_NAME=id-datasaturday-jobs
ENTRA_ADMIN_NAME='REPLACE-Entra-administrator-group'
ENTRA_ADMIN_OBJECT_ID=00000000-0000-0000-0000-000000000000
ENTRA_ADMIN_TYPE=Group
# Azure-wide SQL firewall exception, not limited to this subscription or agent.
ALLOW_AZURE_SERVICES=true
# Add your actual public IPv4 address before administering SQL; [] allows no administrator IPs.
ADMIN_FIREWALL_RULES_JSON='[]'
# Subscription and resource group shared by the two existing stress servers.
STRESS_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
STRESS_RESOURCE_GROUP=REPLACE-target-rg
STRESS_SERVER_01=datasaturday01
STRESS_DATABASE_01=datasaturdaydb01
STRESS_SERVER_02=datasaturday02
STRESS_DATABASE_02=datasaturdaydb02
